# Copy to .env.local and fill in your own values.
# Never commit .env.local — it is gitignored for a reason.

# ─── Supabase ────────────────────────────────────────────────
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key bypasses RLS. Server-side only, never expose this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Encryption ──────────────────────────────────────────────
# 32-byte base64 key used to AES-256-GCM encrypt per-user API keys
# stored in the user_secrets table.
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# ─── App ─────────────────────────────────────────────────────
# Used for OAuth callback URLs. Set to your deployed URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Oura (optional) ─────────────────────────────────────────
# Create an app at https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# ─── AI keys ─────────────────────────────────────────────────
# NOTE: Atlas uses bring-your-own-key. Each user adds their own
# Anthropic and OpenAI keys through /settings, and those are stored
# encrypted in the database. The vars below are only used by the
# one-off maintenance scripts in scripts/, never by the app itself.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
