# Copy to .env.local and fill in your own values.
# Never commit .env.local — it is gitignored for a reason.

# ─── Supabase ────────────────────────────────────────────────
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key bypasses RLS. Server-side only, never expose this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Encryption ──────────────────────────────────────────────
# 32-byte base64 key used to AES-256-GCM encrypt per-user API keys
# stored in the user_secrets table. Required for any AI feature to work.
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# ─── App ─────────────────────────────────────────────────────
# Used for OAuth callback URLs. Set to your deployed URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Wearables (all optional; one provider active per user) ──
# Oura — https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# WHOOP — https://developer.whoop.com
# Note: WHOOP refresh tokens ROTATE on every refresh; both tokens must be
# persisted immediately on each exchange or the connection silently dies.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Fitbit — goes through the Google Health API, not the legacy Fitbit Web API
# (that one was retired 2026-09-30). Create an OAuth client in Google Cloud
# and publish the consent screen to Production; leaving it in Testing caps
# refresh tokens at 7 days.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# ─── Invite gate (optional) ──────────────────────────────────
# Atlas has no self-serve signup. These gate the invite flow.
INVITE_TOKEN=
INVITE_MAX_SIGNUPS=

# ─── Demo account (optional) ─────────────────────────────────
# Read-only demo login, if you want one.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
DEMO_LOGIN_TOKEN=

# ─── AI keys ─────────────────────────────────────────────────
# NOTE: Atlas uses bring-your-own-key. Each user adds their own Anthropic
# and OpenAI keys through /settings, and those are stored encrypted in the
# database. There is deliberately NO global fallback in app code, so these
# two are used only by the one-off maintenance scripts in scripts/.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
